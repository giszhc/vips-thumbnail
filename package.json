{
  "name": "@giszhc/vips-thumbnail",
  "version": "0.2.3",
  "description": "基于 libvips 的图片压缩和缩略图命令行工具",
  "bin": {
    "thumbnail": "dist/thumbnail"
  },
  "files": [
    "dist/thumbnail",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "node --check bin/thumbnail.js && npm run build && node dist/thumbnail --help",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giszhc/vips-thumbnail.git"
  },
  "homepage": "https://github.com/giszhc/vips-thumbnail#readme",
  "bugs": "https://github.com/giszhc/vips-thumbnail/issues",
  "keywords": [
    "libvips",
    "image",
    "thumbnail",
    "compress",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "esbuild": "^0.20.0"
  },
  "license": "MIT"
}
